{
  "name": "TRiBL",
  "displayName": "TRiBL",
  "expo": {
    "name": "Tribl",
    "slug": "Tribl",
    "version": "1.1.0",
    "scheme": "betribl",
    "assetBundlePatterns": ["**/*"],
    "androidStatusBar": {
      "barStyle": "light-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive"
    },
    "ios": {
      "bundleIdentifier": "com.thetriblnetwork.tribl"
    },
    "android": {
      "enableDangerousExperimentalLeanBuilds": true,
      "useNextNotificationsApi": true
    }
  }
}
